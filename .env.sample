# API Keys (이곳에 실제 발급받은 키를 입력하세요. 따옴표 없이 입력합니다.)
UNSPLASH_API_KEY=your_unsplash_access_key_here
PEXELS_API_KEY=your_pexels_api_key_here
PIXABAY_API_KEY=your_pixabay_api_key_here

NAVER_CLIENT_ID=발급받은_네이버_클라이언트_ID
NAVER_CLIENT_SECRET=발급받은_네이버_클라이언트_SECRET

# Common Settings
TARGET_KEYWORD=muscular man
BASE_SAVE_PATH=F:\Images

# ---- 선택 항목 (없으면 기본값 사용) ----

# 이번 실행에서 받을 최대 장수. 비워 두면 가능한 만큼 전부.
MAX_DOWNLOADS=2000

# 요청 1건당 타임아웃(ms). 회사망이 느리면 늘리세요.
REQUEST_TIMEOUT_MS=60000

# 네트워크 오류 시 재시도 횟수 (1s → 2s → 4s → 8s 백오프)
MAX_RETRIES=4

# 이미지 해상도. 원본은 용량이 커서 전송 중 끊길 확률이 높습니다.
# unsplash: full | raw | regular(기본, 1080px) | small
UNSPLASH_IMAGE_SIZE=regular
# pexels: original | large2x(기본, 1880px) | large
PEXELS_IMAGE_SIZE=large2x