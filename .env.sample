# API Keys (이곳에 실제 발급받은 키를 입력하세요. 따옴표 없이 입력합니다.)
UNSPLASH_API_KEY=your_unsplash_access_key_here
PEXELS_API_KEY=your_pexels_api_key_here
PIXABAY_API_KEY=your_pixabay_api_key_here

NAVER_CLIENT_ID=발급받은_네이버_클라이언트_ID
NAVER_CLIENT_SECRET=발급받은_네이버_클라이언트_SECRET

# Common Settings
# 이미지 저장 폴더. 그 아래 {키워드}\{사이트}\ 로 저장됩니다. 비워 두면 프로젝트의 Image 폴더.
BASE_SAVE_PATH=F:\Images

# ---- 선택 항목 (없으면 기본값 사용) ----

# 키워드×사이트 작업 하나에서 새로 저장할 최대 장수. 비워 두면 2000.
MAX_DOWNLOADS=2000

# 요청 1건당 타임아웃(ms). 회사망이 느리면 늘리세요.
REQUEST_TIMEOUT_MS=60000

# 네트워크 오류 시 재시도 횟수 (1s → 2s → 4s → 8s 백오프)
MAX_RETRIES=4

# 이미지 해상도. 원본은 용량이 커서 전송 중 끊길 확률이 높습니다.
# unsplash: full | raw | regular(기본, 1080px) | small
UNSPLASH_IMAGE_SIZE=regular
# pexels: original | large2x(기본, 1880px) | large
PEXELS_IMAGE_SIZE=large2x

# 작업 상태를 저장하는 SQLite 파일. 비워 두면 프로젝트의 data\pipeline.db
DB_PATH=

# 지각 해시가 이 비트 수 이하로 다르면 같은 이미지로 봅니다 (0~64, 기본 5).
# 값을 올리면 중복을 더 많이 잡지만 서로 다른 사진을 중복으로 볼 위험도 커집니다.
PHASH_THRESHOLD=5

# ---- 검출 워커 (python -m app detect) ----

# 모델 폴더. 비워 두면 프로젝트의 models (yolo\, swinv2\, dinov2\ 가 들어 있어야 합니다)
MODEL_DIR=

# 양성 검출의 Crop, 원본 사본, metadata.jsonl 을 날짜 폴더(YYYYMMDD_dataset)에 저장 (true/false, 기본 true)
DETECT_SAVE_CROPS=true

# 날짜 폴더를 만들 상위 폴더. 비워 두면 프로젝트의 detect
DETECT_SAVE_PATH=

# SwinV2·DINOv2 실행 장치: auto(GPU 가 있으면 GPU) | cuda | cpu
DETECT_DEVICE=auto

# Hugging Face 백본(약 2GB) 캐시 위치. C 드라이브가 좁으면 다른 드라이브로 옮기세요.
# HF_HOME=F:\hf-cache
